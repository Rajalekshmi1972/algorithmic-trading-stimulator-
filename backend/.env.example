# =================================================================
# AlgoTradeX Backend Configuration
# =================================================================

# Database connection URL (SQLite default, PostgreSQL supported)
DATABASE_URL=sqlite:///./algotradex.db
# DATABASE_URL=postgresql://postgres:password@localhost:5432/algotradex

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Demo mode (set true to force bundled offline historical data)
DEMO_MODE=false

# Cache TTL for Yahoo Finance price data (seconds)
YFINANCE_CACHE_TTL_SECONDS=900

# -----------------------------------------------------------------
# Security & Session Authentication
# -----------------------------------------------------------------
# Replace with a strong random secret key in production (e.g. openssl rand -hex 32)
SECRET_KEY=algotradex-super-secret-key-change-in-production-2025
TOKEN_EXPIRE_MINUTES=10080

# -----------------------------------------------------------------
# SMTP Email Provider Configuration (Real Email OTP Delivery)
# -----------------------------------------------------------------
# Leave SMTP_HOST empty for local development (codes will be logged to server console)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM_EMAIL=noreply@algotradex.io
SMTP_FROM_NAME=AlgoTradeX Security
SMTP_TLS=true

# -----------------------------------------------------------------
# OTP Verification Parameters
# -----------------------------------------------------------------
OTP_EXPIRE_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
